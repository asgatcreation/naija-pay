# naija-pay — local development environment
#
# Copy to .env and fill in TEST/SANDBOX credentials ONLY. Never put live keys here.
# .env is gitignored. The same names are used for the GitHub Actions secrets that
# run the weekly sandbox drift workflow.
#
# Leave a provider blank to skip its sandbox tests.

# --- Paystack --------------------------------------------------------------
# Dashboard > Settings > API Keys & Webhooks. Must start with sk_test_
PAYSTACK_SECRET_KEY=

# --- Flutterwave -----------------------------------------------------------
# v3 keys: Settings > API Keys. Secret key must start with FLWSECK_TEST-
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
# The secret hash you choose yourself for webhook verification
FLUTTERWAVE_SECRET_HASH=
# v4 OAuth 2.0 credentials from the developer sandbox dashboard
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=

# --- Monnify ---------------------------------------------------------------
# Monnify publishes public sandbox credentials in its own docs, so these can be
# filled from there without an account. Test keys start with MK_TEST_
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# --- Fincra ----------------------------------------------------------------
# Dashboard > Settings > API keys and webhook configuration
FINCRA_SECRET_KEY=
FINCRA_PUBLIC_KEY=
# Separate from the secret key — used only to verify webhooks
FINCRA_WEBHOOK_SECRET=
FINCRA_BUSINESS_ID=

# --- Squad (GTCO) ----------------------------------------------------------
# Sandbox keys start with sandbox_sk_
SQUAD_SECRET_KEY=
SQUAD_MERCHANT_ID=

# --- Korapay (Kora) --------------------------------------------------------
KORAPAY_SECRET_KEY=
KORAPAY_PUBLIC_KEY=

# --- Local development -----------------------------------------------------
# Where the mock provider sends its signed test webhooks
NAIJA_PAY_WEBHOOK_URL=http://localhost:3000/webhooks
NAIJA_PAY_ENV=test
